#version 450

// Frame generation, step 1 (render/frame_gen.cpp; docs/graphics.md "Frame generation"): each pixel of this frame,
// moved back along its motion to where it was at the in-between time, marks that place. Two runs: the first keeps
// the nearest depth that lands on each place (reverse Z: the greatest; atomic max), the second writes the motion of
// the pixel that won. What moves in front covers what is behind, as in the frame itself.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depth_map;  // this frame's depth (scene size)
layout(set = 0, binding = 1) uniform sampler2D motion_map; // its motion: UV to last frame's place (temporal_prep.frag)
layout(set = 0, binding = 2, r32ui) uniform uimage2D key_img;   // per place: the winning depth's key, 0 none
layout(set = 0, binding = 3, r32ui) uniform uimage2D field_img; // per place: the winner's motion (packHalf2x16)
layout(set = 0, binding = 9, r32ui) uniform uimage2D prev_key_img; // per place a frame ago: the nearest key there

layout(push_constant) uniform Push {
    ivec2 size; // the scene's, in pixels
    float t;    // the in-between time (0 last frame .. 1 this one)
    uint pass;  // 0: the depths; 1: the winners' motion
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec2 m = texelFetch(motion_map, p, 0).xy;
    if (any(greaterThan(abs(m), vec2(2.0)))) return; // temporal_prep.frag's "behind last frame's camera"
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    // A point here now was at uv + m a frame ago; at time t it is (1 - t) of the way back.
    ivec2 q = ivec2(floor((uv + (1.0 - pc.t) * m) * vec2(pc.size)));
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pc.size))) return;
    // Depths in 0..1 compare as their bits; + 1 so the sky (0) marks its places too.
    // A see-through part with motion of its own (a character's glass shield) is the nearer surface there, though it
    // wrote no depth (temporal_prep.frag's blue): its pixels move with it.
    uint key = floatBitsToUint(max(texelFetch(depth_map, p, 0).r, texelFetch(motion_map, p, 0).z)) + 1u;
    if (pc.pass == 0u) {
        imageAtomicMax(key_img, q, key);
        // Where it was a frame ago too: fg_synth.frag tells from it whether the last frame's sample along a motion
        // was hidden there behind something nearer (what moves across a still character).
        ivec2 q0 = ivec2(floor((uv + m) * vec2(pc.size)));
        if (all(greaterThanEqual(q0, ivec2(0))) && all(lessThan(q0, pc.size))) imageAtomicMax(prev_key_img, q0, key);
    }
    else if (imageLoad(key_img, q).r == key)
        imageStore(field_img, q, uvec4(packHalf2x16(m)));
}
